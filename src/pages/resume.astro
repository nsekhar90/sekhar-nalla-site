---
import Base from "../layouts/Base.astro";

const LINKEDIN = "https://www.linkedin.com/in/sekhar-nalla-2bb46763/";
const EMAIL = "nalla.sekhar90@gmail.com";
const PHONE = "(352) 870-7643";

const skills = {
  "Mobile & Platform": ["Android", "Kotlin", "Kotlin Multiplatform (KMP/KMM)", "iOS XCFrameworks", "modular SDKs", "MVVM", "Coroutines"],
  "Architecture & Integrations": ["REST APIs", "authentication", "networking", "remote logging", "partner integrations"],
  "Engineering Productivity": ["Gradle", "TeamCity", "CI/CD", "remote build caching", "multi-repository releases", "Maestro", "AI agents", "MCP", "Jira automation"],
};

const roles = [
  {
    company: "GEN",
    location: "Mountain View, CA",
    positions: [
      {
        title: "Lead Software Engineer",
        dates: "June 2026–Present",
        bullets: [
          "Own mobile architecture and delivery for Identity Theft Protection across the LifeLock consumer app and partner products, including Norton 360, BT, CVS, and ADP, using Android and Kotlin Multiplatform feature SDKs consumed by iOS.",
          "Built AI-agent workflows with SRE to automate release orchestration, failed PR-check remediation, downstream dependency updates, regression-fix tagging, and release-to-develop synchronization.",
          "Led AI-augmented delivery practices across the Identity organization, including Jira-driven bug-fix workflows, Maestro reproduce-and-verify loops, MCP integrations, and agentic PR triage and review.",
        ],
      },
      {
        title: "Senior Principal Software Engineer",
        dates: "July 2022–June 2026",
        bullets: [
          "Led the migration of the Identity portfolio from monolithic host-app implementations to modular Kotlin Multiplatform feature SDKs shared by Android and iOS.",
          "Established a three-layer architecture—native Android UI, shared KMP model/repository modules, and shared networking core—to scale feature delivery across products.",
          "Centralized authentication, API integration, remote logging, and networking into shared core modules, reducing duplicated implementation and narrowing the iOS framework surface area.",
          "Delivered independently consumable SDKs for credit monitoring, financial monitoring, alerts, locks, restoration, plan details, and upsell, accelerating partner onboarding without host-app compile-time coupling.",
          "Led multi-repository SDK and app release engineering; reduced CI duration 53% through change-aware TeamCity pipelines and remote Gradle build caching, with conditional execution contributing 37%.",
        ],
      },
      {
        title: "Principal Software Engineer",
        dates: "July 2019–June 2022",
        bullets: [
          "Introduced Kotlin Multiplatform and led shared networking infrastructure used by Android and iOS applications.",
          "Modernized Android engineering through RxJava 1→2 migration, R8 enablement, and developer/QA debugging tooling; contributed shared feature delivery across LifeLock and Norton 360.",
        ],
      },
    ],
  },
  {
    company: "LogMeIn",
    location: "Santa Barbara / Mountain View, CA",
    positions: [
      {
        title: "Senior Software Engineer, Android",
        dates: "March 2018–June 2019",
        bullets: [
          "Built, tested, reviewed, and released Android applications for GoToMeeting, GoToWebinar, and GoToTraining, including WebRTC audio/video meeting experiences.",
          "Modernized the Android codebase with contemporary build tooling, clean architecture, Dagger-based dependency injection, and automated testing.",
          "Helped launch GoToMeeting Free; received Citrix Top Honors for design-driven execution and rapid delivery.",
        ],
      },
      {
        title: "Software Engineer, Android",
        dates: "June 2014–March 2018",
        bullets: [],
      },
    ],
  },
  {
    company: "Grooveshark",
    location: "Gainesville, FL",
    positions: [
      {
        title: "Android Developer Intern",
        dates: "January 2014–April 2014",
        bullets: [],
      },
    ],
  },
];

const education = [
  { school: "University of Florida", degree: "M.S., Computer Engineering", year: "2014" },
  { school: "Amrita School of Engineering", degree: "B.Tech., Electronics & Communication Engineering", year: "2012" },
];
---

<Base title="Resume" description="Résumé of Sekhar Nalla — Lead Mobile Software Engineer (Android, Kotlin Multiplatform, Mobile Platforms & Engineering Productivity).">
  <section class="resume-page">
    <div class="container resume-container">
      <!-- Print/download bar -->
      <div class="resume-toolbar">
        <div>
          <p class="eyebrow">Résumé</p>
          <h1 class="resume-name">Sekhar Nalla</h1>
          <p class="resume-tagline muted">Lead Mobile Software Engineer · Android, Kotlin Multiplatform, Mobile Platforms &amp; Engineering Productivity</p>
        </div>
        <div class="toolbar-actions">
          <a href="/resume/Sekhar_Nalla_Resume.pdf" download class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download PDF
          </a>
          <a href={LINKEDIN} rel="noopener noreferrer" target="_blank" class="btn btn-ghost">LinkedIn</a>
        </div>
      </div>

      <!-- Contact -->
      <p class="resume-contact">
        San Jose, CA · <a href={`tel:${PHONE.replace(/[^0-9+]/g, "")}`}>{PHONE}</a> · <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={LINKEDIN} rel="noopener noreferrer" target="_blank">LinkedIn</a>
      </p>

      <!-- Skills -->
      <div class="resume-block">
        <h2 class="resume-heading">Technical expertise</h2>
        <dl class="skills-grid">
          {
            Object.entries(skills).map(([category, items]) => (
              <div class="skill-row">
                <dt>{category}</dt>
                <dd>{items.join(" · ")}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Experience -->
      <div class="resume-block">
        <h2 class="resume-heading">Professional experience</h2>
        {
          roles.map((role) => (
            <section class="role">
              <header class="role-header">
                <h3 class="role-company">{role.company}</h3>
                <span class="role-location muted">{role.location}</span>
              </header>
              {role.positions.map((pos) => (
                <div class="position">
                  <div class="position-bar">
                    <span class="position-title">{pos.title}</span>
                    <span class="position-dates">{pos.dates}</span>
                  </div>
                  {pos.bullets.length > 0 && (
                    <ul class="bullet-list">
                      {pos.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </section>
          ))
        }
      </div>

      <!-- Education -->
      <div class="resume-block">
        <h2 class="resume-heading">Education</h2>
        <ul class="edu-list">
          {
            education.map((e) => (
              <li>
                <span class="edu-school">{e.school}</span>
                <span class="muted"> — {e.degree}</span>
                <span class="edu-year">{e.year}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .resume-page {
    padding-block: var(--space-12) var(--space-20);
  }
  .resume-container {
    max-width: 880px;
  }
  .resume-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .resume-name {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
  }
  .resume-tagline {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
  .toolbar-actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .resume-contact {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .resume-contact a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .resume-contact a:hover {
    color: var(--color-primary);
  }
  .resume-block {
    margin-top: var(--space-12);
  }
  .resume-heading {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-primary);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-divider);
  }
  .skills-grid {
    display: grid;
    gap: var(--space-4);
  }
  .skill-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-4);
  }
  .skill-row dt {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .skill-row dd {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .role {
    margin-bottom: var(--space-8);
  }
  .role-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .role-company {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .role-location {
    font-size: var(--text-xs);
  }
  .position {
    margin-top: var(--space-1);
  }
  .position-bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: baseline;
  }
  .position-title {
    font-weight: 600;
    font-size: var(--text-base);
  }
  .position-dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .bullet-list {
    list-style: none;
    padding-left: 0;
    margin-top: var(--space-3);
  }
  .bullet-list li {
    position: relative;
    padding-left: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--color-text);
    line-height: 1.65;
    max-width: 78ch;
  }
  .bullet-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }
  .edu-list {
    display: grid;
    gap: var(--space-2);
  }
  .edu-list li {
    font-size: var(--text-sm);
  }
  .edu-school {
    font-weight: 600;
  }
  .edu-year {
    float: right;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .position-bar {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
