---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/* Scope these rules to the KMM XCFramework article wrapper. */
.kmm-xcframework-post .diagram-wrap {
  margin: 2rem 0;
  padding: clamp(1rem, 3vw, 2rem);
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 0.75rem;
  background: var(--surface);
}

.kmm-xcframework-post .arch-diagram {
  display: block;
  width: 100%;
  max-width: 720px;
  height: auto;
  margin: 0 auto;
}

.kmm-xcframework-post .diagram-wrap figcaption {
  margin-top: 1rem;
  color: var(--muted);
  font-size: 0.9rem;
  font-style: italic;
  text-align: center;
}

.kmm-xcframework-post .table-wrap {
  margin: 1.5rem 0;
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 0.75rem;
  background: var(--surface);
}

.kmm-xcframework-post .table-wrap table {
  width: 100%;
  min-width: 620px;
  margin: 0;
  border: 0;
  border-collapse: collapse;
}

.kmm-xcframework-post .table-wrap th,
.kmm-xcframework-post .table-wrap td {
  border: 0;
  border-bottom: 1px solid var(--line);
  vertical-align: middle;
}

.kmm-xcframework-post .table-wrap th {
  padding: 0.9rem 1rem;
  color: var(--muted);
  background: color-mix(in srgb, var(--surface) 92%, var(--teal));
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 500;
  letter-spacing: 0.09em;
  line-height: 1.3;
  text-align: left;
  text-transform: uppercase;
}

.kmm-xcframework-post .table-wrap td {
  padding: 1rem;
  line-height: 1.45;
}

.kmm-xcframework-post .table-wrap tbody tr:last-child td {
  border-bottom: 0;
}

.kmm-xcframework-post .table-wrap td:nth-child(n + 2),
.kmm-xcframework-post .table-wrap th:nth-child(n + 2) {
  white-space: nowrap;
}

.kmm-xcframework-post .phase-comparison td:not(:first-child),
.kmm-xcframework-post .phase-comparison th:not(:first-child) {
  text-align: center;
}

.kmm-xcframework-post .phase-comparison td:nth-child(n + 2) {
  font-size: 1.15rem;
}

@media (max-width: 700px) {
  .kmm-xcframework-post .table-wrap table {
    min-width: 560px;
  }

  .kmm-xcframework-post .table-wrap th,
  .kmm-xcframework-post .table-wrap td {
    padding: 0.8rem 0.9rem;
  }
}

// Rough reading time estimate from the raw markdown length.
const wordCount = post.body?.replace(/[#>*_`-]/g, " ").trim().split(/\s+/).length ?? 200;
const readingTime = String(Math.max(1, Math.round(wordCount / 200)));
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  tags={post.data.tags}
  readingTime={readingTime}
>
  <Content />
</BlogPost>
