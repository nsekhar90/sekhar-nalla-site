---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Sekhar Nalla — Lead Mobile Software Engineer building Android and Kotlin Multiplatform platforms, improving mobile delivery systems, and applying AI automation to engineering workflows.",
  ogImage = "/og-default.svg",
  structuredData = [],
} = Astro.props;

const siteUrl = "https://sekhar-nalla.dev";
const fullTitle = title === "Sekhar Nalla" ? title : `${title} — Sekhar Nalla`;
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const siteStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Sekhar Nalla",
    url: siteUrl,
    jobTitle: "Lead Mobile Software Engineer",
    sameAs: ["https://www.linkedin.com/in/sekhar-nalla-2bb46763/"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Sekhar Nalla",
    url: siteUrl,
  },
];
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Sekhar Nalla">
    <meta property="og:image" content={`${siteUrl}${ogImage}`}>
    <meta property="og:image:alt" content={fullTitle}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`}>
    <link rel="canonical" href={pageUrl}>
    <script type="application/ld+json" set:html={JSON.stringify([...siteStructuredData, ...pageStructuredData])}></script>

    <link rel="sitemap" href="/sitemap-index.xml">

    <!-- Fonts: Cabinet Grotesk + Satoshi (Fontshare), JetBrains Mono (Google) -->
    <link rel="preconnect" href="https://api.fontshare.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    >
  </head>
  <body>
    <a
      href="#main"
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0"
    >Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
